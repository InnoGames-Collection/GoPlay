# GoPlay Backend Environment Configuration
NODE_ENV=production
PORT=3302
ADMIN_PORT=3303
HOST=0.0.0.0
DOMAIN=goplay.com.et

# Database (Postgres 16)
DATABASE_URL=postgresql://goplay_app:goplay_secure_prod_password_2026@127.0.0.1:5434/goplay_db
DB_MAX_CONNECTIONS=20

# Cache (Valkey 8)
VALKEY_URL=redis://127.0.0.1:6384

# Security Secrets
JWT_SECRET=goplay-telebirr-jwt-secret-key-prod-2026
GAME_TOKEN_SECRET=goplay-anti-cheat-round-token-secret-2026
CRON_SECRET=goplay-cron-secret-prod-2026
RATE_LIMIT_GENERAL=60

# Telebirr Game Center C2B/B2C Integration
TELEBIRR_MODE=live
TELEBIRR_APP_ID=YOUR_TELEBIRR_APP_ID
TELEBIRR_APP_KEY=YOUR_TELEBIRR_APP_KEY
TELEBIRR_PUBLIC_KEY=YOUR_TELEBIRR_PUBLIC_KEY
TELEBIRR_SHORT_CODE=9891
TELEBIRR_CHECKOUT_URL=https://telebirr.et/checkout
TELEBIRR_NOTIFY_URL=https://goplay.com.et/api/v1/payments/webhook
TELEBIRR_RETURN_URL=https://goplay.com.et/#/profile
DEFAULT_TEST_MSISDN=0977057270
