# ==============================================================================
# GoPlay Backend — Production Environment Template
# ==============================================================================

NODE_ENV=production
PORT=3302
ADMIN_PORT=3303
HOST=0.0.0.0
DOMAIN=innopulseplatform.com

# PostgreSQL Database
DATABASE_URL=postgresql://goplay_app:your_secure_db_password@127.0.0.1:5432/goplay?sslmode=disable
DB_MAX_CONNECTIONS=20

# Valkey / Redis
VALKEY_URL=redis://127.0.0.1:6379

# Security & Anti-Cheat
JWT_SECRET=replace_with_strong_random_jwt_secret_64chars
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
GAME_TOKEN_SECRET=replace_with_strong_random_anti_cheat_token_secret
CRON_SECRET=replace_with_strong_random_cron_secret

# Rate Limiting
RATE_LIMIT_GENERAL=60

# TeleBirr SuperApp Integration
TELEBIRR_MODE=live
TELEBIRR_APP_KEY=your_telebirr_live_app_key
TELEBIRR_APP_ID=your_telebirr_live_app_id
TELEBIRR_PUBLIC_KEY=your_telebirr_public_key
TELEBIRR_CHECKOUT_URL=https://telebirr.et/checkout
TELEBIRR_NOTIFY_URL=https://goplay.innopulseplatform.com/api/webhooks/telebirr/callback
TELEBIRR_RETURN_URL=https://goplay.innopulseplatform.com/#/profile

# Brevo Transactional Email & Admin Magic Link Auth
BREVO_API_KEY=your_brevo_v3_api_key
BREVO_SENDER_EMAIL=innospher@gmail.com
BREVO_SENDER_NAME="GoPlay Operations Console"
MAGIC_LINK_SECRET=replace_with_strong_random_magic_link_secret
ADMIN_PORTAL_URL=https://goplay-admin.innopulseplatform.com
